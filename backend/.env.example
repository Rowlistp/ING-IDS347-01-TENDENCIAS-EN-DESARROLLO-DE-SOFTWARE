# Configuración local del backend. Nunca coloque aquí una clave o credencial real
# ni cargue este archivo con datos reales al repositorio: es solo una plantilla.
# El doble guion bajo (__) es la convención de ASP.NET Core para variables de
# entorno anidadas (Jwt__Key equivale a la clave de configuración "Jwt:Key").
# Alternativa recomendada para desarrollo local: dotnet user-secrets set "Jwt:Key" "..."
# desde backend/FuelTrack.Api/.

# Fase 1. Obligatorio: la app no arranca sin esto (ValidateOnStart en Program.cs).
# Debe tener al menos 32 caracteres.
Jwt__Key=REEMPLAZAR_CON_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES

# Obligatorio: cadena de conexión a PostgreSQL.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=fueltrack;Username=fueltrack;Password=REEMPLAZAR

# Configuración Fase 4. Obligatorio: la app no arranca sin esto (ValidateOnStart en Program.cs).
Tickets__Prefix=COM
Tickets__SigningPrivateKeyPkcs8Base64=REEMPLAZAR_CON_BASE64_PKCS8_ECDSA_P256
Tickets__SigningPublicKeySpkiBase64=REEMPLAZAR_CON_BASE64_SPKI_ECDSA_P256
