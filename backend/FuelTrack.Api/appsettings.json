{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "FuelTrack.Api",
    "Audience": "FuelTrack.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Authentication": {
    "Keycloak": {
      "Enabled": false,
      "Authority": "",
      "Audience": "fueltrack-api",
      "IdentityClaim": "preferred_username",
      "RequireHttpsMetadata": true
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  }
}
